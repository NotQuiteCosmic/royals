# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.eggs/

# Stale Python 2 bytecode committed before this repo existed
main.pyc

# Written into the checkout by install-desktop.sh, not part of the source
/royals-desktop

# Editors / OS
.idea/
.vscode/
.DS_Store

# Secrets — never commit these
.env
.env.*
!.env.example

# Claude Code local overrides (settings.json IS tracked, this one is per-machine)
.claude/settings.local.json

# NOTE: golden.txt and golden_search.txt ARE tracked deliberately, despite the size.
# They are the rules contract — see tests/regress.py. Do not add them here.

# Tuning runs and match results are outputs, not source; the pool and the book are tracked
tuning/runs/
tuning/results/*
!tuning/results/verdicts.jsonl
